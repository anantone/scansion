#!/usr/bin/env ruby
# frozen_string_literal: true

# Permet de lancer l'exécutable directement depuis une copie de travail
# (checkout) ; quand le gem est installé, lib est déjà dans le load path
# et ceci est sans effet.
lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

require "scansion"

Scansion.main
